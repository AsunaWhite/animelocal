{
  "name": "animelocal",
  "version": "0.3.0",
  "private": true,
  "description": "本季番剧库 · 本地动画管理与吐槽工具",
  "main": "src/main/main.js",
  "scripts": {
    "start": "node scripts/launch.js",
    "dev": "node scripts/launch.js --dev",
    "shot": "node scripts/launch.js --shot",
    "test": "node scripts/test-catalog.js && node scripts/test-library.js && node scripts/test-scanner.js && node scripts/test-romaji.js && node scripts/test-play.js && node scripts/test-notes.js",
    "test:catalog": "node scripts/test-catalog.js",
    "test:library": "node scripts/test-library.js",
    "test:scanner": "node scripts/test-scanner.js",
    "test:romaji": "node scripts/test-romaji.js",
    "test:play": "node scripts/test-play.js",
    "test:notes": "node scripts/test-notes.js",
    "test:live": "node scripts/test-catalog.js --live",
    "icon": "powershell -NoProfile -ExecutionPolicy Bypass -File build/make-icon.ps1",
    "pack": "electron-builder --win --dir",
    "dist": "electron-builder --win portable"
  },
  "build": {
    "appId": "com.asunawhite.animelocal",
    "productName": "AnimeLocal",
    "copyright": "AnimeLocal",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json",
      "!**/*.map"
    ],
    "asar": true,
    "win": {
      "target": [
        "portable"
      ],
      "icon": "build/icon.ico",
      "artifactName": "${productName}-${version}-portable.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.${ext}"
    }
  },
  "keywords": [
    "electron",
    "anime"
  ],
  "license": "MIT",
  "devDependencies": {
    "electron": "^44.7.0",
    "electron-builder": "^26.18.0"
  },
  "dependencies": {
    "cheerio": "^1.2.0"
  }
}
